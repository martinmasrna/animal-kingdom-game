#!/usr/bin/env bash
# Every check, in parallel: the Python tests spread over the cores (pytest-xdist) and the web client's suite at the same
# time. Prints one line each, the failures in full.
#
#   ./test                    # both suites
#   ./test animal_kingdom/tests/test_rules.py   # named Python tests only, in the foreground, a second or two
set -uo pipefail
cd "$(dirname "$0")"
if (( $# )); then exec .venv/bin/python -m pytest -q -p no:cacheprovider "$@"; fi
out="$(mktemp -d)"; trap 'rm -rf "$out"' EXIT
.venv/bin/python -m pytest -q -n auto -p no:cacheprovider > "$out/py" 2>&1 & py=$!
(cd animal_kingdom/web/test && node --test > "$out/web" 2>&1) & web=$!
wait $py; pys=$?; wait $web; webs=$?
(( pys )) && cat "$out/py" || echo "python: $(tail -1 "$out/py")"
(( webs )) && grep -vE '^# Subtest|^ok ' "$out/web" | tail -60 || echo "web: $(grep -E '^ℹ (pass|fail) ' "$out/web" | tr '\n' ' ')"
exit $(( pys || webs ))
