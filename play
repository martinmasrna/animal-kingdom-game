#!/usr/bin/env bash
# Launch the web client: starts the server and opens it in the browser.
#
#   ./play                    # http://localhost:8000
#   ./play --port 8001 --no-open
#   ./play --host 0.0.0.0     # reachable from other machines on the network
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$here/.venv/bin/python"

if [[ ! -x "$py" ]]; then
  echo "No virtualenv at $here/.venv — create it first:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi
if ! "$py" -c "import aiohttp" 2>/dev/null; then
  "$py" -m pip install -q -e "$here[web]"
fi

# The rules engine is compiled (engine_rs/): rebuild it when its source moved. If that fails the server still starts on
# the module it has, and says so; with no module at all there is no game to serve.
if ! "$here/engine_rs/build.sh" --if-stale; then
  "$py" -c "import ak_engine" 2>/dev/null || { echo "no rules engine is built: fix the build above, then ./play (engine_rs/build.sh builds it)" >&2; exit 1; }
  echo "PLAYING ON THE LAST ENGINE THAT BUILT: rule changes since then are not in this server" >&2
fi

# The server reads the cards, decks, maps, engine and its own code once; tools/play/watch.py restarts it when any of
# them changes, so a card edit shows within a second. AK_NO_WATCH=1 runs it once, as before.
if [[ "${AK_NO_WATCH:-}" == "1" ]]; then
  exec "$py" -m animal_kingdom.web.server "$@"
fi
exec "$py" "$here/tools/play/watch.py" "$@"
